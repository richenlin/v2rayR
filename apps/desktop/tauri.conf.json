{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "v2rayR",
  "identifier": "com.v2rayr.client",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "v2rayR",
        "width": 860,
        "height": 640,
        "minWidth": 860,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns"
    ],
    "externalBin": ["embedded-cores/v2rayr-core-sing-box", "embedded-cores/v2rayr-core-xray"],
    "resources": {
      "../../resources/rules/*": "_up_/_up_/resources/rules/",
      "embedded-cores/xray-assets/": "xray-assets/",
      "embedded-cores/licenses/": "core-licenses/"
    },
    "category": "Utility",
    "shortDescription": "Proxy client for sing-box and Xray",
    "longDescription": "v2rayR is a desktop proxy client: manage nodes and subscriptions, test latency, and run sing-box, Xray or mihomo with a typed configuration builder."
  }
}
